@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// HAT variant of the stock Linux device tree, with the same radio and camera.
+#include "rk3566-radxa-zero-3w-aic8800ds2.dts"
+
+// Pollen Robot HAT on header pins 3 (SDA) and 5 (SCL).  Leave
+// the SoC hardware i2c3 at M1 for the board's FUSB302 USB-C PD.
+&{/} {
+	pihat_i2c: i2c-pihat {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio1 RK_PA0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio1 RK_PA1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pihat_i2c_pins>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pihat_codec: codec@18 {
+			// Keep the control names expected by the upstream HAT mixer.
+			compatible = "ti,tlv320aic3x";
+			reg = <0x18>;
+			#sound-dai-cells = <0>;
+			clocks = <&pihat_codec_mclk>;
+			clock-names = "mclk";
+		};
+	};
+
+	pihat_codec_mclk: aic3104-mclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <12000000>;
+	};
+
+	sound-aic3104 {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "aic3104";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&pihat_cpu_dai>;
+		simple-audio-card,frame-master = <&pihat_cpu_dai>;
+
+		pihat_cpu_dai: simple-audio-card,cpu {
+			sound-dai = <&i2s3_2ch>;
+			// Do not set mclk-fs on the card: the codec's physical
+			// 12 MHz oscillator is independent of the RK3566 sysclk.
+			system-clock-frequency = <12288000>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&pihat_codec>;
+		};
+	};
+};
+
+&pinctrl {
+	pihat {
+		pihat_i2c_pins: pihat-i2c-pins {
+			rockchip,pins = <1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
+					<1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&i2s3_2ch {
+	status = "okay";
+};
