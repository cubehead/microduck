+[Unit]
+Description=Initialize Zero 3W Robot HAT speaker and microphone mixer
+Before=robotd.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+TimeoutStartSec=5s
+ExecStart=@LIBEXECDIR@/microduck-zero3-hat-audio-init
+NoNewPrivileges=yes
+ProtectSystem=strict
+ProtectHome=yes
+
+[Install]
+WantedBy=multi-user.target
diff --git a/meta-microduck-bsp/recipes-bsp/microduck-zero3-hat-audio/microduck-zero3-hat-audio.bb b/meta-microduck-bsp/recipes-bsp/microduck-zero3-hat-audio/microduck-zero3-hat-audio.bb
