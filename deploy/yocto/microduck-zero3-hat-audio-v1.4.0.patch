@@ -0,0 +1,32 @@
+#!/bin/sh
+# Mixer controls match pollen-robotics/microduck deploy/audio/aic3104-init.sh.
+set -eu
+
+# Probe the named card, not card0 (which could be HDMI or USB audio).
+# Wait briefly for deferred probe, without making robotd depend on the codec.
+attempt=0
+while ! amixer -c aic3104 info >/dev/null 2>&1; do
+    attempt=$((attempt + 1))
+    if [ "$attempt" -ge 8 ]; then
+        echo "aic3104 sound card not detected; Robot HAT audio was not initialized" >&2
+        exit 0
+    fi
+    sleep 0.25
+done
+
+# Set route and level before unmuting. Leave the output-stage boost at 0 dB.
+amixer -q -c aic3104 cset name='PCM Playback Volume' 127,127
+amixer -q -c aic3104 cset name='Line DAC Playback Volume' 118,118
+amixer -q -c aic3104 cset name='Line Playback Volume' 0,0
+amixer -q -c aic3104 cset name='Line Playback Switch' on,on
+
+# The HAT's local microphone is wired to Mic3R of the right PGA.
+for input in 'Left PGA Mixer Mic3R' 'Left PGA Mixer Mic3L' \
+             'Right PGA Mixer Mic3L' 'Right PGA Mixer Line1R' 'Right PGA Mixer Line1L' \
+             'Left PGA Mixer Line1R' 'Left PGA Mixer Line1L' 'Right PGA Mixer Line2R'; do
+    amixer -q -c aic3104 sset "$input" off
+done
+amixer -q -c aic3104 sset 'Right PGA Mixer Mic3R' on
+amixer -q -c aic3104 cset name='PGA Capture Volume' 60,60
+amixer -q -c aic3104 cset name='PGA Capture Switch' on,on
+echo "aic3104 speaker and MIC3R mixer initialized"
