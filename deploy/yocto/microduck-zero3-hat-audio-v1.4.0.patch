@@ -0,0 +1,28 @@
+SUMMARY = "Mixer setup for the Zero 3W Pollen Robot HAT"
+DESCRIPTION = "Initializes the AIC3104 speaker and MIC3R capture paths at boot."
+LICENSE = "MIT"
+LIC_FILES_CHKSUM = "file://${COREBASE}/meta/COPYING.MIT;md5=3da9cfbcb788c80a0384361b4de20420"
+
+SRC_URI = " \
+    file://microduck-zero3-hat-audio.service \
+    file://microduck-zero3-hat-audio-init \
+"
+
+S = "${UNPACKDIR}"
+PACKAGE_ARCH = "${MACHINE_ARCH}"
+COMPATIBLE_MACHINE = "^microduck-zero3$"
+
+inherit systemd
+
+SYSTEMD_SERVICE:${PN} = "microduck-zero3-hat-audio.service"
+SYSTEMD_AUTO_ENABLE = "enable"
+
+RDEPENDS:${PN} = "alsa-utils-amixer"
+
+do_install() {
+	install -d ${D}${libexecdir} ${D}${systemd_system_unitdir}
+	install -m 0755 ${UNPACKDIR}/microduck-zero3-hat-audio-init ${D}${libexecdir}/
+	install -m 0644 ${UNPACKDIR}/microduck-zero3-hat-audio.service ${D}${systemd_system_unitdir}/
+	# Honor the distro's libexecdir rather than assuming an install prefix.
+	sed -i 's|@LIBEXECDIR@|${libexecdir}|g' ${D}${systemd_system_unitdir}/microduck-zero3-hat-audio.service
+}
